{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/solutions", "destination": "/#solutions", "permanent": false },
    { "source": "/solutions/:match*", "destination": "/#solutions", "permanent": false },
    { "source": "/our-tech", "destination": "/#technology", "permanent": false },
    { "source": "/our-tech/:match*", "destination": "/#technology", "permanent": false },
    { "source": "/resources/case-studies/:match*", "destination": "/#impact", "permanent": false },
    { "source": "/resources/research-and-insights/:match*", "destination": "/#research", "permanent": false },
    { "source": "/resources/news-and-media/:match*", "destination": "/#research", "permanent": false },
    { "source": "/resources", "destination": "/#impact", "permanent": false },
    { "source": "/resources/:match*", "destination": "/#impact", "permanent": false },
    { "source": "/our-company", "destination": "/#contact", "permanent": false },
    { "source": "/our-company/:match*", "destination": "/#contact", "permanent": false },
    { "source": "/contact", "destination": "/#contact", "permanent": false },
    { "source": "/contact/:match*", "destination": "/#contact", "permanent": false },
    { "source": "/privacy-policy/:match*", "destination": "/#contact", "permanent": false },
    { "source": "/terms-of-use/:match*", "destination": "/#contact", "permanent": false },
    { "source": "/home/:match*", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(app\\.framerstatic\\.com|framerusercontent\\.com|fonts\\.gstatic\\.com|r2-assets\\.prakriti\\.earth)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
